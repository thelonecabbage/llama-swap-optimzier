# Copy this file to .env and replace placeholders with local values.
# Process environment variables and explicit CLI flags take precedence.

# llama-swap endpoint
LLAMA_SWAP_BASE_URL=http://127.0.0.1:8080
LLAMA_SWAP_API_KEY=

# Models used by benchmark_all_models.py
MODEL=text-model
CORE_MODELS=text-model,code-model
VL_MODELS=vision-model
MODEL_DEFAULTS_JSON='{"text-model":{"MODEL_PATH":"/models/text-model.gguf","GPU_LAYERS":"0"},"code-model":{"MODEL_PATH":"/models/code-model.gguf","GPU_LAYERS":"0"},"vision-model":{"MODEL_PATH":"/models/vision-model.gguf","MMPROJ":"/models/vision-projector.gguf","GPU_LAYERS":"0"}}'

# Benchmark defaults
BENCHMARK_MODELS=text-model
BENCHMARK_CASES_FILE=benchmark_cases.json
BENCHMARK_RESULTS_FILE=benchmark_results.jsonl
BENCHMARK_SUMMARY_FILE=benchmark_summary.csv
BENCHMARK_RUNS=3
BENCHMARK_WARMUPS=1
BENCHMARK_TIMEOUT=900
BENCHMARK_TEMPERATURE=0.0
BENCHMARK_CONFIG_ID=baseline
BENCHMARK_NOTES=
BENCHMARK_SCRIPT=./benchmark_all_models.py
BENCHMARK_WRAPPER_LOG_DIR=./benchmark-wrapper-logs

# Sweep defaults
SHORT_RUNS=3
LONG_RUNS=2
WARMUPS=1
TIMEOUT=1800
DIRECT_MODE=0

# DIRECT mode container and server settings
DIRECT_CONTAINER=llama-swap
DIRECT_HOST=0.0.0.0
DIRECT_PORT=18080
DIRECT_RESTART_CONTAINER=1
DIRECT_START_TIMEOUT=300

# DIRECT mode llama-server defaults. Per-model JSON values override these.
CTX_SIZE=32768
PARALLEL=1
THREADS=6
THREADS_BATCH=6
GPU_LAYERS=0
BATCH_SIZE=256
UBATCH_SIZE=64
JINJA=1
