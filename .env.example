# Copy this file to .env and replace placeholders with local values.
# This file holds environment-specific config: endpoints, credentials,
# and model selection/paths. Generic tuning defaults shared by every
# environment live in .defaults and do not need to be repeated here.
# Precedence: .defaults < .env < process environment variables < CLI flags.

# llama-swap endpoint
# Base URL of the running llama-swap / llama.cpp OpenAI-compatible server.
LLAMA_SWAP_BASE_URL=http://127.0.0.1:8080
# Bearer token for the endpoint above, if it requires authentication.
LLAMA_SWAP_API_KEY=

# Model selection is unified here; legacy MODEL / CORE_MODELS / VL_MODELS aliases still work.
# Comma-separated model IDs to benchmark; drives both single-model and sweep runs.
MODELS=text-model,code-model,vision-model
# JSON map of model ID to its launch settings (MODEL_PATH, GPU_LAYERS, MMPROJ, etc.).
MODEL_DEFAULTS_JSON='{"text-model":{"MODEL_PATH":"/models/text-model.gguf","GPU_LAYERS":"0"},"code-model":{"MODEL_PATH":"/models/code-model.gguf","GPU_LAYERS":"0"},"vision-model":{"MODEL_PATH":"/models/vision-model.gguf","MMPROJ":"/models/vision-projector.gguf","GPU_LAYERS":"0"}}'

# Optional: declare input modalities per model for benchmark capability
# detection (benchmark_llama_swap.py), instead of relying on live probing.
# Takes precedence over MMPROJ-based inference from MODEL_DEFAULTS_JSON above.
# Values: any combination of "text", "image", "audio". "text" is always implied.
# MODEL_CAPABILITIES_JSON='{"vision-model":["text","image"]}'

# Optional: override the default local path for a real (non-synthetic)
# multimodal benchmark asset fetched once via `python3 fetch_assets.py`.
# See benchmark_cases.json's real_image_vqa/real_document_qa/real_audio_transcribe
# cases for the corresponding default paths under assets/.
# BENCHMARK_ASSET_CAT_IMAGE=/path/to/cat.jpg

# DIRECT mode container/server (environment-specific; restart/timeout behavior lives in .defaults)
# Name of the Docker container running llama-server for DIRECT mode benchmarks.
DIRECT_CONTAINER=llama-swap
# Host/interface the harness tells llama-server to bind to inside the container.
DIRECT_HOST=0.0.0.0
# Port the harness tells llama-server to listen on and connects to for benchmarking.
DIRECT_PORT=18080
